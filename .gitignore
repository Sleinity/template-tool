# Local-only fixture and font directories. The committed manifests retain
# hash-gated identities; real source binaries remain external unless their
# redistribution rights are explicitly approved.
fidelity/private-assets/
fidelity/local-archive/

# Renderer-fidelity run output is retained locally, not committed.
fidelity/artifacts/
fidelity/candidates/
fidelity/update-evidence/
