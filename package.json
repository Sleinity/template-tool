{
  "name": "template-tool-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm packages:build",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "pnpm packages:build",
    "build": "tsc -b && vite build",
    "test": "node scripts/run-tests.mjs",
    "test:realistic-zip": "node scripts/run-tests.mjs --realistic-zip-strict",
    "test:diagnostic-zips": "node scripts/run-diagnostic-zips.mjs",
    "fidelity:baseline": "node scripts/fidelity/cli.mjs baseline",
    "fidelity:compare": "node scripts/fidelity/cli.mjs compare",
    "fidelity:source-authoritative": "node scripts/fidelity/cli.mjs baseline --fixture now-hiring-post --font-profile source-authoritative",
    "fidelity:source-authoritative:compare": "node scripts/fidelity/cli.mjs compare --fixture now-hiring-post --font-profile source-authoritative",
    "fidelity:update": "node scripts/fidelity/cli.mjs update",
    "fidelity:fixture": "node scripts/fidelity/cli.mjs baseline --fixture",
    "fidelity:report": "node scripts/fidelity/cli.mjs report",
    "image-placement:crop-evidence": "node scripts/image-placement/crop-source-evidence.mjs",
    "image-placement:replacement-authority": "node scripts/image-placement/replacement-authority.mjs",
    "image-placement:png-determinism": "node scripts/fidelity/cli.mjs baseline --fixture deal-of-the-week-banner --surface png-export --repeat 5",
    "mask:source-evidence": "node scripts/masks/source-evidence.mjs",
    "mask:browser-scenarios": "node scripts/masks/browser-scenarios.mjs",
    "primitives:source-evidence": "node scripts/primitives/source-evidence.mjs",
    "primitives:stroke-source-evidence": "node scripts/primitives/stroke-source-evidence.mjs",
    "primitives:browser-scenarios": "node scripts/primitives/browser-scenarios.mjs",
    "primitives:performance": "node scripts/primitives/performance.mjs",
    "ordered-solids:source-evidence": "node scripts/ordered-solids/source-evidence.mjs",
    "ordered-solids:browser-scenarios": "node scripts/primitives/browser-scenarios.mjs --fixture ordered-solid-blue-then-red,ordered-solid-red-then-blue,ordered-solid-three,ordered-solid-hidden-middle,ordered-solid-paint-opacity,ordered-solid-independent-corners",
    "ordered-solids:performance": "node scripts/primitives/performance.mjs --fixture ordered-solid-blue-then-red,ordered-solid-red-then-blue,ordered-solid-three,ordered-solid-hidden-middle,ordered-solid-paint-opacity,ordered-solid-independent-corners --output fidelity/evidence/milestone-7-4-ordered-solids/performance.json",
    "mixed-paints:source-evidence": "node scripts/mixed-paints/source-evidence.mjs",
    "gradients:source-evidence": "node scripts/gradients/source-evidence.mjs",
    "gradients:browser-scenarios": "node scripts/primitives/browser-scenarios.mjs",
    "gradients:performance": "node scripts/gradients/performance.mjs",
    "gradients:regression-evidence": "node scripts/gradients/regression-evidence.mjs",
    "scene:baseline": "node scripts/scene-graph/cli.mjs baseline",
    "scene:compare": "node scripts/scene-graph/cli.mjs compare",
    "scene:update": "node scripts/scene-graph/cli.mjs update",
    "scene:inspect": "node scripts/scene-graph/cli.mjs inspect",
    "scene:equivalence": "node scripts/scene-graph/cli.mjs equivalence",
    "scene:report": "node scripts/scene-graph/cli.mjs report",
    "settlement:baseline": "node scripts/settlement/cli.mjs baseline",
    "settlement:observe": "node scripts/settlement/cli.mjs observe",
    "settlement:compare": "node scripts/settlement/cli.mjs compare",
    "settlement:update": "node scripts/settlement/cli.mjs update",
    "settlement:scenario": "node scripts/settlement/cli.mjs scenario",
    "settlement:browser-scenarios": "node scripts/settlement/browser-scenarios.mjs",
    "settlement:report": "node scripts/settlement/cli.mjs report",
    "runtime-routing:stage4a": "node scripts/runtime-routing/stage4a.mjs",
    "runtime-routing:scenarios": "node scripts/settlement/browser-scenarios.mjs",
    "runtime-routing:fonts": "node scripts/runtime-routing/font-evidence.mjs",
    "runtime-routing:text-trim": "node scripts/runtime-routing/text-trim.mjs",
    "runtime-routing:text-trim-review": "node scripts/runtime-routing/text-trim-review.mjs",
    "appearance:baseline": "node scripts/appearance-contracts/cli.mjs baseline",
    "appearance:report": "node scripts/appearance-contracts/cli.mjs report",
    "docs:verify": "node scripts/verify-doc-links.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "packages:build": "pnpm --filter './packages/*' build",
    "packages:typecheck": "pnpm --filter './packages/*' typecheck",
    "packages:pack:check": "node scripts/repository/verify-package-archives.mjs",
    "boundaries:check": "node scripts/repository/verify-package-boundaries.mjs",
    "repository:audit": "node scripts/repository/audit-git-readiness.mjs",
    "sdk:verify": "pnpm packages:typecheck && pnpm packages:build && pnpm boundaries:check && pnpm packages:pack:check",
    "example:dev": "pnpm --filter @sleinity/template-minimal-renderer dev",
    "example:build": "pnpm --filter @sleinity/template-minimal-renderer build",
    "ci:portable": "pnpm repository:audit && pnpm test && pnpm exec tsc -b --pretty false && pnpm build && pnpm test:realistic-zip && pnpm docs:verify && pnpm sdk:verify && pnpm example:build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm sdk:verify && changeset publish"
  },
  "dependencies": {
    "@sleinity/template-browser": "workspace:*",
    "@sleinity/template-core": "workspace:*",
    "@sleinity/template-react": "workspace:*",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.20",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/pngjs": "6.0.5",
    "pixelmatch": "7.1.0",
    "playwright": "1.61.1",
    "pngjs": "7.0.0",
    "tsup": "^8.5.0"
  }
}
