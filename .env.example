# Optional Figma enrichment is import-time only. Leave these empty when using
# the deterministic ZIP-first and offline renderer workflow.
FIGMA_MCP_PROVIDER_URL=
FIGMA_MCP_PROVIDER_TOKEN=
FIGMA_ACCESS_TOKEN=

# External, hash-gated fidelity inputs. These directories are not published in
# Git or in the reusable SDK packages.
TEMPLATE_PACKAGE_FIXTURE_DIR=/absolute/path/to/template-package-zips
RENDERER_FIDELITY_FONT_DIR=/absolute/path/to/renderer-fidelity-fonts
INTER_TIGHT_FIDELITY_FONT_PATH=/absolute/path/to/InterTight-VariableFont_wght.ttf
