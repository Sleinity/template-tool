{
  "name": "@sleinity/template-core",
  "version": "0.2.2",
  "description": "Framework-neutral TemplatePackage ZIP importer, validator, canonical scene, resolver, and field override API.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sleinity/template-tool.git",
    "directory": "packages/template-core"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --external react --external react-dom --external ajv --external fflate",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fflate": "^0.8.3"
  }
}
