{
  "name": "@sleinity/template-react",
  "version": "0.4.1",
  "description": "Studio-independent React renderer and inspection integration for TemplatePackage applications.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sleinity/template-tool.git",
    "directory": "packages/template-react"
  },
  "private": false,
  "type": "module",
  "sideEffects": [
    "./dist/importer.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./importer": {
      "types": "./dist/importer.d.ts",
      "import": "./dist/importer.js"
    },
    "./importer.css": {
      "default": "./dist/importer.css"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts src/importer.tsx --format esm --dts --sourcemap --clean --external @sleinity/template-core --external @sleinity/template-browser --external react --external react-dom",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sleinity/template-browser": "workspace:*",
    "@sleinity/template-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
