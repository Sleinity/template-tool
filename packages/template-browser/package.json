{
  "name": "@sleinity/template-browser",
  "version": "0.4.1",
  "description": "Browser asset, font, persistence, readiness, and deterministic PNG services for TemplatePackage rendering.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sleinity/template-tool.git",
    "directory": "packages/template-browser"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./importer": {
      "types": "./dist/importer.d.ts",
      "import": "./dist/importer.js"
    },
    "./compatibility": {
      "types": "./dist/compatibility.d.ts",
      "import": "./dist/compatibility.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts src/session.ts src/importer.ts src/compatibility.ts --format esm --dts --sourcemap --clean --external @sleinity/template-core --external react --external react-dom --external ajv --external fflate --external html-to-image",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sleinity/template-core": "workspace:*",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13"
  }
}
